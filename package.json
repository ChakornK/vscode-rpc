{
  "name": "vsc-discord-rpc",
  "displayName": "Discord RPC",
  "description": "A simple no-config Discord RPC extension",
  "version": "0.0.3",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/chakornk/vscode-rpc"
  },
  "publisher": "ChakornK",
  "license": "MIT",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.104.0"
  },
  "keywords": [
    "discord",
    "rich",
    "presence",
    "rpc",
    "status",
    "activity"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "galleryBanner": {
    "color": "#5865F2",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "discord-rpc",
          "title": "Discord RPC",
          "icon": "assets/discord.svg"
        }
      ]
    },
    "views": {
      "discord-rpc": [
        {
          "id": "discord-rpc-settings",
          "name": "Presence Settings"
        }
      ]
    },
    "configuration": {
      "title": "Discord RPC",
      "properties": {
        "discordRpc.showFile": {
          "type": "boolean",
          "default": true,
          "description": "Show the active file name in Rich Presence."
        },
        "discordRpc.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show line and column numbers (:line:col)."
        },
        "discordRpc.showWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Show workspace/project name in icon tooltip."
        },
        "discordRpc.showElapsedTime": {
          "type": "boolean",
          "default": true,
          "description": "Show timer with elapsed editing time."
        },
        "discordRpc.showIdle": {
          "type": "boolean",
          "default": true,
          "description": "Show presence when no editor is open."
        },
        "discordRpc.smallImageText": {
          "type": "string",
          "default": "Visual Studio Code",
          "description": "Hover text (tooltip) for the small Discord icon."
        },
        "discordRpc.idleText": {
          "type": "string",
          "default": "Idling",
          "description": "Title/details text shown when idling or no editor is active."
        }
      }
    },
    "commands": [
      {
        "command": "discordRpc.editTextSetting",
        "title": "Discord RPC: Edit Text Setting"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run build",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "build": "yarn run check-types && node esbuild.js --production",
    "package": "vsce package --no-yarn",
    "deploy": "vsce publish --no-yarn",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.6.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "esbuild-plugin-yaml": "^0.0.1",
    "eslint": "10.2.1",
    "npm-run-all": "^4.1.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "packageManager": "yarn@4.12.0"
}
